<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reading_tracker_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">
    <TextView
        android:id="@+id/widget_buddy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="📚 Page"
        android:textColor="#D7B78E"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Choose your next book"
        android:textColor="#F1EADF"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_pages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Open Reading Tracker to choose a book"
        android:textColor="#B4B5AA"
        android:textSize="11sp" />
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="9dp"
        android:progress="0"
        android:progressBackgroundTint="#3A4038"
        android:progressTint="#8AC2A2" />
    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="end"
        android:text="🔥 0 day streak"
        android:textColor="#D7B78E"
        android:textSize="10sp" />
</LinearLayout>
